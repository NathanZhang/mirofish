# Copy to deploy/graphiti-local/.env (chmod 600). Generate real random credentials.
GRAPHITI_SERVICE_TOKEN=replace-with-local-random-token
GRAPH_DB_PROVIDER=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-random-password
GRAPH_LLM_BASE_URL=http://127.0.0.1:30000/v1
GRAPH_LLM_MODEL=qwen3.8-27b
GRAPH_LLM_SMALL_MODEL=qwen3.8-27b
GRAPH_LLM_API_KEY=existing-local-model-credential
GRAPH_LLM_STRUCTURED_OUTPUT_MODE=json_schema
GRAPH_EMBEDDING_BASE_URL=http://127.0.0.1:5102/v1
GRAPH_EMBEDDING_MODEL=BAAI/bge-m3
GRAPH_EMBEDDING_DIM=1024
GRAPH_EMBEDDING_API_KEY=replace-with-local-random-token
# Absolute path written by services/embedding/download_model.py
EMBEDDING_MODEL_PATH=/absolute/path/to/mirofish/data/graphiti-local/bge-m3
GRAPH_SEARCH_RERANKER=rrf
GRAPH_MAX_COROUTINES=2
GRAPH_INGEST_WORKERS=1
GRAPH_JOB_DEADLINE_SECONDS=1800
SEMAPHORE_LIMIT=2
GRAPHITI_TELEMETRY_ENABLED=false
